# Copy to .env.local. Never commit real values.

# Board sign-in. Does not open Admin.
APP_SYSTEM_ID=
# Separate key for workflows and email templates.
APP_ADMIN_ID=
SESSION_SECRET=
CRON_SECRET=
# Bearer token for /api/tasks. External services send Authorization: Bearer <token>.
API_TOKEN=

# Where the morning mail and reminders are delivered.
OPERATOR_EMAIL=

# Required on Vercel. Leave empty locally to use the private file store in .data/.
DATABASE_URL=

# Optional until you want real email. MAIL_FROM must be a sender Resend has verified.
RESEND_API_KEY=
MAIL_FROM=
